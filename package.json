{
  "name": "itilite-saas-backend",
  "version": "1.0.0",
  "description": "Production-grade SaaS backend starter with JWT auth and RBAC",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "format:check": "prettier --check \"**/*.{js,ts,tsx,json,md,css}\"",
    "format:write": "prettier --write \"**/*.{js,ts,tsx,json,md,css}\"",
    "clean": "powershell -NoProfile -Command \"$paths = @('frontend/.next','frontend/out','dist','server_debug.log'); foreach ($p in $paths) { if (Test-Path $p) { Remove-Item -Recurse -Force $p } }\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^8.23.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "uuid": "^9.0.0",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1"
  }
}
